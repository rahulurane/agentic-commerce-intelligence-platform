# ACIP environment configuration (12-factor). Copy to .env and adjust.
# .env is gitignored; never commit real secrets. (docs/07 §2)

# --- messaging ---
KAFKA_BOOTSTRAP=redpanda:9092

# --- stores ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/password
POSTGRES_DSN=postgresql://acip:acip@postgres:5432/acip
REDIS_URL=redis://redis:6379/0

# --- llm ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_FALLBACK_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=/secrets/adc.json

# --- decisioning ---
DECISION_DEADLINE_MS=800
FRAUD_BLOCK_THRESHOLD=0.85
APPROVE_MAX=0.35
CHALLENGE_MAX=0.70
W_RISK=0.5
W_FRAUD=0.5

# --- representation + methods ---
REPRESENTATION_VERSION=1
ENABLED_METHOD_TYPES=card,upi,netbanking,wallet,cod

# --- processor sim ---
SIM_APPROVAL_RATE=0.9
SIM_LATENCY_MS=40
SIM_FAILURE_MODE=none

# --- service URLs ---
REPRESENTATION_URL=http://representation-service:8000
ML_SCORING_URL=http://ml-scoring-service:8000
LLM_GATEWAY_URL=http://llm-gateway:8000
DECISION_ENGINE_URL=http://decision-engine:8000
PAYMENT_PROCESSOR_URL=http://payment-processor-sim:8000
ORCHESTRATOR_URL=http://commerce-orchestrator:8000

# --- ml + decisioning policy ---
ML_MODELS_DIR=/app/ml/models
MISSING_RISK_FRAUD_POLICY=CHALLENGE

# --- policy + merchant agent config ---
POLICY_SANCTIONED_GEOS=XX
# Absolute policy hard-veto amount ceiling. Separate from (and above) the merchant
# soft-CHALLENGE threshold so a hard veto and a soft step-up never share one threshold.
POLICY_AMOUNT_HARD_CAP=10000.0
MERCHANT_HIGH_VALUE_CHALLENGE=4000.0
