# ACIP LOCAL run-mode configuration. Copy to .env.local (start-local.sh does this for
# you if absent) and adjust. .env.local is gitignored; never commit real secrets.
#
# This is the LOCAL (host-process) variant of .env.example: the backing infra still runs
# in Docker (`make up-infra`), but the 14 ACIP application services run as HOST uvicorn
# processes (see start-local.sh) and the React demo UI runs via the Vite dev server on
# http://localhost:5173 (`npm run dev`). Because everything talks over published host
# ports, the stores and inter-service URLs point at localhost instead of the compose
# service names. The all-Docker path keeps using .env.example (do NOT modify that file).

# --- messaging ---
# Redpanda already advertises OUTSIDE://localhost:19092 and publishes 19092:19092.
KAFKA_BOOTSTRAP=localhost:19092

# --- stores (reachable on localhost via the published compose ports) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/password
POSTGRES_DSN=postgresql://acip:acip@localhost:5432/acip
REDIS_URL=redis://localhost:6379/0

# --- llm ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_FALLBACK_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=/secrets/adc.json

# --- decisioning ---
DECISION_DEADLINE_MS=800
FRAUD_BLOCK_THRESHOLD=0.85
APPROVE_MAX=0.35
CHALLENGE_MAX=0.70
W_RISK=0.5
W_FRAUD=0.5

# --- representation + methods ---
REPRESENTATION_VERSION=1
ENABLED_METHOD_TYPES=card,upi,netbanking,wallet,cod

# --- processor sim ---
SIM_APPROVAL_RATE=0.9
SIM_LATENCY_MS=40
SIM_FAILURE_MODE=none

# --- service URLs (host processes on distinct local ports; see start-local.sh) ---
ORCHESTRATOR_URL=http://localhost:8081
REPRESENTATION_URL=http://localhost:8082
ML_SCORING_URL=http://localhost:8083
LLM_GATEWAY_URL=http://localhost:8084
DECISION_ENGINE_URL=http://localhost:8085
PAYMENT_PROCESSOR_URL=http://localhost:8086

# --- ml + decisioning policy ---
# Host path (not the container's /app/ml/models): the ml-scoring host process reads the
# trained artifacts straight from the repo's ml/models dir. start-local.sh runs from the
# repo root, so this relative path resolves there (start-local trains if it's missing).
ML_MODELS_DIR=ml/models
MISSING_RISK_FRAUD_POLICY=CHALLENGE

# --- policy + merchant agent config ---
POLICY_SANCTIONED_GEOS=XX
# Absolute policy hard-veto amount ceiling. Separate from (and above) the merchant
# soft-CHALLENGE threshold so a hard veto and a soft step-up never share one threshold.
POLICY_AMOUNT_HARD_CAP=10000.0
MERCHANT_HIGH_VALUE_CHALLENGE=4000.0
